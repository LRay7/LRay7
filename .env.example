# --- All optional. GigHound's default configuration costs $0 to run. ---

# Ticketmaster Discovery API key (free tier) — enables the arena/theater source.
# https://developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Extraction backend: claude-cli (default; uses your Claude subscription via
# `claude -p`, no API key) | api (pay per token) | none (structured-only)
# GIGHOUND_EXTRACTOR=claude-cli

# Model for the claude-cli fallback. Keep this on haiku for routine crawling.
# GIGHOUND_CLI_MODEL=haiku

# Hard cap on LLM fallback calls per crawl run.
# GIGHOUND_MAX_LLM_CALLS=8

# Only needed if GIGHOUND_EXTRACTOR=api (also: pip install -e ".[api]")
# ANTHROPIC_API_KEY=sk-ant-...

# Where the SQLite DB lives (default: ./data/gighound.db)
# GIGHOUND_DB_PATH=
